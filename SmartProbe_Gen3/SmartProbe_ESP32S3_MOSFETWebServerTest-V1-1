// ═══════════════════════════════════════════════
//  PIN DEFINITIONS  (matches TimeLapse_S3 V1-2)
// ═══════════════════════════════════════════════
#define I2C_SDA          8    // I2C data
#define I2C_SCL          9    // I2C clock
#define SOIL_ADC_PIN     1    // ADC1_CH0 — capacitive soil probe
#define BATT_ADC_PIN     3    // ADC1_CH2 — battery voltage divider mid-point
#define MOSFET_GATE_PIN  4    // N-ch MOSFET gate: HIGH = rail ON
#define NEO_PIN          2    // WS2812B data (on MOSFET-switched rail)
#define NEO_COUNT        1

// ═══════════════════════════════════════════════
//  I2C ADDRESSES
// ═══════════════════════════════════════════════
#define BH1750_ADDR   0x23
#define BMP180_ADDR   0x77

// ═══════════════════════════════════════════════
//  TIMING
// ═══════════════════════════════════════════════
#define SENSOR_POWER_ON_DELAY_MS  1200   // time for rail + sensors to stabilise
#define BH1750_SETTLE_MS           180   // high-res continuous mode settle
#define LOOP_INTERVAL_MS          2000   // sensor read interval
#define SENSOR_TEST_MS           30000   // active sensor-test window
#define EXTENDED_MS              30000   // extra awake time after test
#define RAINBOW_CYCLES               3   // rainbow loops before sleep
#define SLEEP_MS                 30000   // MOSFET-off duration

// ═══════════════════════════════════════════════
//  BMP180 — ALTITUDE COMPENSATION
//  Set to your deployment site altitude in metres.
//  Matches TimeLapse_S3 constant — keep in sync.
// ═══════════════════════════════════════════════
#define SITE_ALTITUDE_M   50.0f   // ← change to your site altitude

// ═══════════════════════════════════════════════
//  SOIL SENSOR CALIBRATION  (matches TimeLapse_S3)
//  Measure raw ADC (analogRead, 12-bit) in dry air → SOIL_ADC_DRY
//  Measure raw ADC fully submerged              → SOIL_ADC_WET
// ═══════════════════════════════════════════════
#define SOIL_ADC_DRY    3100   // raw ADC when dry
#define SOIL_ADC_WET    1200   // raw ADC when saturated
#define SOIL_SAMPLES      16   // oversampling count

// ═══════════════════════════════════════════════
//  BATTERY VOLTAGE  (matches TimeLapse_S3)
//  Two equal 100 kΩ resistors → BATT_DIVIDER_RATIO = 2.0
// ═══════════════════════════════════════════════
#define BATT_DIVIDER_RATIO   2.0f
#define BATT_ADC_SAMPLES       16

#define BATT_FULL_V   4.15f
#define BATT_LOW_V    3.50f
#define BATT_CRIT_V   3.20f

// ═══════════════════════════════════════════════
//  OBJECTS
// ═══════════════════════════════════════════════
BH1750            lightMeter;
Adafruit_BMP085   bmp;
Adafruit_NeoPixel pixel(NEO_COUNT, NEO_PIN, NEO_GRB + NEO_KHZ800);
AsyncWebServer    server(80);

// ═══════════════════════════════════════════════
//  STATE MACHINE
// ═══════════════════════════════════════════════
enum State { STATE_SENSOR_TEST, STATE_EXTENDED, STATE_RAINBOW, STATE_SLEEP };
State    currentState = STATE_SENSOR_TEST;
uint32_t stateStartMs = 0;
uint32_t lastSensorMs = 0;

// ═══════════════════════════════════════════════
//  SENSOR FLAGS + LATEST READINGS
//  Battery is read before MOSFET on; all others
//  are read after. Globals persist across loop().
// ═══════════════════════════════════════════════
bool    bh1750Found        = false;
bool    bmp180Found        = false;

float   lastLux            = -1.0f;
bool    luxOk              = false;

float   lastTempC          =  0.0f;
float   lastPressStationHPa=  0.0f;   // BMP180 raw station pressure
float   lastPressSLHPa     =  0.0f;   // sea-level corrected
float   lastAltM           =  0.0f;
bool    bmpOk              = false;

int     lastSoilRaw        = -1;
int     lastSoilPct        = -1;
bool    soilOk             = false;

float   lastBattV          = -1.0f;
int     lastBattPct        = -1;
bool    battOk             = false;
bool    battLow            = false;
bool    battCrit           = false;

uint32_t lastReadMs        = 0;

// ═══════════════════════════════════════════════
//  FORWARD DECLARATIONS
// ═══════════════════════════════════════════════
void     setupI2C();
void     powerOnSensors();
void     powerOffSensors();
float    readBatteryVoltage();
int      battVoltageToPercent(float v);
float    computeSeaLevelPressure(float stationHPa, float altitudeM);
void     readBattery();
void     readSensors();
void     scanI2C();
void     runRainbow();
void     enterSensorTest();
void     enterExtended();
void     enterRainbow();
void     enterSleep();
String   buildDataJSON();
String   buildStatusJSON();
void     startWebServer();
void     connectWiFi();
const char* stateName();

// ═══════════════════════════════════════════════
//  STATE NAME
// ═══════════════════════════════════════════════
const char* stateName() {
  switch (currentState) {
    case STATE_SENSOR_TEST: return "SENSOR TEST";
    case STATE_EXTENDED:    return "EXTENDED";
    case STATE_RAINBOW:     return "RAINBOW";
    case STATE_SLEEP:       return "SLEEP";
    default:                return "UNKNOWN";
  }
}

// ═══════════════════════════════════════════════
//  NeoPixel HELPERS
// ═══════════════════════════════════════════════
void setPixel(uint8_t r, uint8_t g, uint8_t b, uint8_t brightness = 40) {
  pixel.setBrightness(brightness);
  pixel.setPixelColor(0, pixel.Color(r, g, b));
  pixel.show();
}

void setPixelHue(uint8_t hue, uint8_t brightness = 60) {
  pixel.setBrightness(brightness);
  pixel.setPixelColor(0, pixel.ColorHSV(hue * 256, 255, 255));
  pixel.show();
}

// ═══════════════════════════════════════════════
//  SEA-LEVEL PRESSURE CONVERSION  (matches TimeLapse_S3)
//  P0 = P_station / (1 - altitude / 44330) ^ 5.255
// ═══════════════════════════════════════════════
float computeSeaLevelPressure(float stationHPa, float altitudeM) {
  float divisor = powf(1.0f - (altitudeM / 44330.0f), 5.255f);
  if (divisor < 0.001f) divisor = 0.001f;
  return stationHPa / divisor;
}

// ═══════════════════════════════════════════════
//  BATTERY VOLTAGE
//  Call BEFORE powerOnSensors() for an unloaded reading.
//  analogReadMilliVolts() uses ESP32 factory ADC calibration.
//  Matches TimeLapse_S3 readBatteryVoltage() exactly.
// ═══════════════════════════════════════════════
float readBatteryVoltage() {
  pinMode(BATT_ADC_PIN, INPUT);
  delay(5);

  uint32_t sumMv = 0;
  for (int i = 0; i < BATT_ADC_SAMPLES; i++) {
    sumMv += analogReadMilliVolts(BATT_ADC_PIN);
    delay(2);
  }
  float adcMv  = (float)(sumMv / BATT_ADC_SAMPLES);
  float battV  = (adcMv * BATT_DIVIDER_RATIO) / 1000.0f;
  Serial.printf("[Batt] ADC=%.1f mV  Battery=%.3f V\n", adcMv, battV);
  return battV;
}

int battVoltageToPercent(float v) {
  const float V_MAX = 4.20f;
  const float V_MIN = 3.00f;
  int pct = (int)(((v - V_MIN) / (V_MAX - V_MIN)) * 100.0f + 0.5f);
  return constrain(pct, 0, 100);
}

// Convenience wrapper — updates all battery globals
void readBattery() {
  lastBattV    = readBatteryVoltage();
  lastBattPct  = battVoltageToPercent(lastBattV);
  battOk       = (lastBattV >= 2.5f && lastBattV <= 4.4f);
  battLow      = (lastBattV < BATT_LOW_V  && lastBattV > 1.0f);
  battCrit     = (lastBattV < BATT_CRIT_V && lastBattV > 1.0f);
  Serial.printf("[Batt] %.3f V  %d%%  %s\n",
                lastBattV, lastBattPct,
                battCrit ? "CRITICAL" : battLow ? "LOW" : "OK");
}

// ═══════════════════════════════════════════════
//  I2C SETUP  (matches TimeLapse_S3 setupI2C())
// ═══════════════════════════════════════════════
void setupI2C() {
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(400000);
  Serial.printf("[I2C] SDA=GPIO%d  SCL=GPIO%d  400 kHz\n", I2C_SDA, I2C_SCL);
}

// ═══════════════════════════════════════════════
//  I2C BUS SCANNER
// ═══════════════════════════════════════════════
void scanI2C() {
  Serial.println("[I2C Scan] Scanning 0x01–0x7F ...");
  int found = 0;
  for (uint8_t addr = 0x01; addr < 0x7F; addr++) {
    Wire.beginTransmission(addr);
    if (Wire.endTransmission() == 0) {
      Serial.printf("  Found 0x%02X", addr);
      if (addr == BH1750_ADDR) Serial.print("  ← BH1750FVI");
      if (addr == BMP180_ADDR) Serial.print("  ← BMP180");
      Serial.println();
      found++;
    }
  }
  Serial.printf("[I2C Scan] %d device(s) found.\n\n", found);
}

// ═══════════════════════════════════════════════
//  SENSOR POWER ON
//  Called AFTER readBattery() so MOSFET was still
//  low during the battery measurement.
// ═══════════════════════════════════════════════
void powerOnSensors() {
  Serial.println("[MOSFET] GPIO4 HIGH — sensors + NeoPixel ON");
  digitalWrite(MOSFET_GATE_PIN, HIGH);
  delay(SENSOR_POWER_ON_DELAY_MS);   // allow rail to stabilise + sensors to boot

  pixel.begin();
  setPixel(0, 0, 255);   // blue = booting

  setupI2C();
  scanI2C();

  bh1750Found = lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE_2, BH1750_ADDR, &Wire);
  Serial.printf("[BH1750] Init: %s\n", bh1750Found ? "OK" : "FAILED");

  bmp180Found = bmp.begin();
  Serial.printf("[BMP180] Init: %s\n", bmp180Found ? "OK" : "FAILED");

  if (!bh1750Found && !bmp180Found) {
    Serial.println("[ERROR] Both sensors missing — check wiring and pull-ups");
    setPixel(255, 0, 0);
  } else if (bh1750Found && bmp180Found) {
    Serial.println("[OK] Both sensors found.");
    setPixel(0, 255, 0);
  } else {
    Serial.println("[WARN] Only one sensor found.");
    setPixel(255, 180, 0);
  }

  delay(BH1750_SETTLE_MS);   // continuous mode settle
}

// ═══════════════════════════════════════════════
//  SENSOR POWER OFF
// ═══════════════════════════════════════════════
void powerOffSensors() {
  setPixel(0, 0, 0, 0);
  delay(10);
  Wire.end();
  Serial.printf("[MOSFET] GPIO4 LOW — sensors + NeoPixel OFF for %d s\n",
                SLEEP_MS / 1000);
  digitalWrite(MOSFET_GATE_PIN, LOW);
}

// ═══════════════════════════════════════════════
//  READ ALL SENSORS
//  BH1750 — continuous mode, no extra settle needed.
//  BMP180 — station pressure validated 500–1150 hPa.
//            sea-level pressure computed from SITE_ALTITUDE_M.
//  Soil   — 16-sample oversample with analogReadMilliVolts()
//            converted to raw 12-bit equivalent for map().
// ═══════════════════════════════════════════════
void readSensors() {
  luxOk = false;
  bmpOk = false;
  soilOk = false;

  // ── BH1750 ───────────────────────────────────
  if (bh1750Found) {
    lastLux = lightMeter.readLightLevel();
    luxOk   = (lastLux >= 0.0f);
    if (luxOk) Serial.printf("[BH1750] %.2f lx\n", lastLux);
    else        Serial.println("[BH1750] Read error");
  } else {
    Serial.println("[BH1750] NOT FOUND");
  }

  // ── BMP180 ───────────────────────────────────
  if (bmp180Found) {
    lastTempC             = bmp.readTemperature();
    float rawPa           = bmp.readPressure();        // Pascals, station pressure
    lastPressStationHPa   = rawPa / 100.0f;            // convert to hPa
    lastAltM              = bmp.readAltitude();        // uses last known sea-level ref
    lastPressSLHPa        = computeSeaLevelPressure(lastPressStationHPa, SITE_ALTITUDE_M);

    // Validate raw Pascals: same range check as TimeLapse_S3
    bmpOk = (rawPa > 50000.0f && rawPa < 115000.0f);
    if (bmpOk) {
      Serial.printf("[BMP180] Temp=%.1f°C  Station=%.2f hPa  SeaLevel=%.2f hPa  Alt=%.0f m\n",
                    lastTempC, lastPressStationHPa, lastPressSLHPa, lastAltM);
    } else {
      Serial.println("[BMP180] Read error — pressure out of valid range");
    }
  } else {
    Serial.println("[BMP180] NOT FOUND");
  }

  // ── Capacitive Soil Moisture ──────────────────
  // analogReadMilliVolts with oversampling, then scale to equivalent 12-bit raw.
  // map() uses the same SOIL_ADC_DRY / SOIL_ADC_WET as TimeLapse_S3.
  {
    uint32_t sumMv = 0;
    for (int i = 0; i < SOIL_SAMPLES; i++) {
      sumMv += analogReadMilliVolts(SOIL_ADC_PIN);
      delay(2);
    }
    float avgMv   = (float)(sumMv / SOIL_SAMPLES);
    // Convert mV → 12-bit raw equivalent  (3300 mV = 4095)
    lastSoilRaw   = (int)((avgMv / 3300.0f) * 4095.0f + 0.5f);
    lastSoilPct   = constrain(
      map(lastSoilRaw, SOIL_ADC_DRY, SOIL_ADC_WET, 0, 100), 0, 100);
    soilOk        = true;
    Serial.printf("[Soil] Raw=%d (%.1f mV)  Moisture=%d%%\n",
                  lastSoilRaw, avgMv, lastSoilPct);
  }

  lastReadMs = millis();

  // Update NeoPixel: green = all OK, yellow = partial, red = all failed
  if      ( luxOk &&  bmpOk) setPixel(0,   255, 0  );
  else if (!luxOk && !bmpOk) setPixel(255, 0,   0  );
  else                        setPixel(255, 180, 0  );

  Serial.println("--------------------------------------------");
}

// ═══════════════════════════════════════════════
//  WiFi — connect once at boot, stays up
// ═══════════════════════════════════════════════
void connectWiFi() {
  Serial.printf("[WiFi] Connecting to %s", WIFI_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  uint32_t t = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t < 10000) {
    delay(500); Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("\n[WiFi] Connected — IP: %s\n", WiFi.localIP().toString().c_str());
    Serial.printf("[WiFi] Dashboard  → http://%s/\n\n", WiFi.localIP().toString().c_str());
  } else {
    Serial.println("\n[WiFi] Failed — running without network.");
  }
}

