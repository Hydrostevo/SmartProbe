    font-size:.78rem;font-family:var(--mono);color:var(--sub);text-align:center}
  .divider{height:1px;background:var(--border);margin:20px 0}
  .sensor-flags{display:flex;gap:16px;margin-top:8px}
  .flag{font-size:.65rem;font-family:var(--mono);padding:3px 8px;border-radius:3px;
    border:1px solid var(--border)}
  .flag.ok{border-color:rgba(34,211,165,.4);color:var(--green)}
  .flag.fail{border-color:rgba(239,68,68,.4);color:var(--red)}
  .footer{margin-top:22px;font-size:.64rem;font-family:var(--mono);
    color:var(--sub);display:flex;gap:16px;flex-wrap:wrap;align-items:center}
  .footer a{color:var(--accent);text-decoration:none}
  .footer a:hover{text-decoration:underline}
  #updated{color:var(--sub);font-size:.64rem;font-family:var(--mono)}
</style>
</head>
<body>
<h1>SmartProbe Diagnostic</h1>
<p class="subtitle" id="updated">connecting...</p>

<div class="grid">
  <div class="card" id="card-lux">
    <div class="card-label">&#x2600; Light Level</div>
    <div class="card-value" id="lux">—</div>
    <div class="card-unit">lux · BH1750FVI</div>
  </div>
  <div class="card" id="card-temp">
    <div class="card-label">&#x1F321; Temperature</div>
    <div class="card-value" id="temp">—</div>
    <div class="card-unit">°C · BMP180</div>
  </div>
  <div class="card" id="card-press-station">
    <div class="card-label">&#x1F4A8; Station Pressure</div>
    <div class="card-value" id="press-station">—</div>
    <div class="card-unit">hPa · raw</div>
  </div>
  <div class="card" id="card-press-sl">
    <div class="card-label">&#x1F30D; Sea-Level Pressure</div>
    <div class="card-value" id="press-sl">—</div>
    <div class="card-unit">hPa · corrected</div>
  </div>
  <div class="card" id="card-alt">
    <div class="card-label">&#x26F0; Altitude</div>
    <div class="card-value" id="alt">—</div>
    <div class="card-unit">metres</div>
  </div>
  <div class="card" id="card-soil">
    <div class="card-label">&#x1F331; Soil Moisture</div>
    <div class="card-value" id="soil">—</div>
    <div class="card-unit">% · capacitive</div>
  </div>
  <div class="card" id="card-battv">
    <div class="card-label">&#x1F50B; Battery Voltage</div>
    <div class="card-value" id="battv">—</div>
    <div class="card-unit">V · divider × 2</div>
  </div>
  <div class="card" id="card-battp">
    <div class="card-label">&#x26A1; Battery Level</div>
    <div class="card-value" id="battp">—</div>
    <div class="card-unit">% · 3.0–4.2 V range</div>
  </div>
</div>

<div class="status-bar">
  <div class="dot grey" id="dot"></div>
  <div class="status-text">
    <div id="status-text">—</div>
    <div class="sensor-flags" id="sensor-flags"></div>
  </div>
  <div class="badge" id="state-badge">—</div>
</div>

<div class="progress-wrap">
  <div class="progress-label">
    <span id="phase-label">Phase progress</span>
    <span id="phase-pct">—</span>
  </div>
  <div class="progress-track">
    <div class="progress-fill" id="progress-fill" style="width:0%"></div>
  </div>
</div>

<div class="sleep-notice" id="sleep-notice">
  &#x1F4A4;&nbsp; MOSFET rail OFF — sensors and NeoPixel powered down.<br>
  Web server remains active. Next cycle starts shortly.
</div>

<div class="divider"></div>
<div class="footer">
  <span id="updated-footer">Auto-refreshes every 3 s</span>
  <a href="/data">JSON /data</a>
  <a href="/status">JSON /status</a>
</div>

<script>
async function refresh(){
  try{
    const[dRes,sRes]=await Promise.all([fetch('/data'),fetch('/status')]);
    const d=await dRes.json(),s=await sRes.json();
    const sleeping=s.state==='SLEEP'||s.state==='RAINBOW';
    const na=v=>sleeping?'--':(v!=null?v:'N/A');

    document.getElementById('lux').textContent         =d.lux_ok        ?d.lux.toFixed(1)               :na(null);
    document.getElementById('temp').textContent        =d.bmp_ok        ?d.temp_c.toFixed(1)             :na(null);
    document.getElementById('press-station').textContent=d.bmp_ok       ?d.pressure_station_hpa.toFixed(1):na(null);
    document.getElementById('press-sl').textContent   =d.bmp_ok        ?d.pressure_sl_hpa.toFixed(1)    :na(null);
    document.getElementById('alt').textContent         =d.bmp_ok        ?d.altitude_m.toFixed(0)         :na(null);
    document.getElementById('soil').textContent        =d.soil_ok       ?d.soil_pct                      :na(null);
    document.getElementById('battv').textContent       =d.batt_ok       ?d.batt_v.toFixed(3)             :'—';
    document.getElementById('battp').textContent       =d.batt_ok       ?d.batt_pct+'%'                  :'—';

    // Battery card colouring
    const cv=document.getElementById('card-battv');
    const cp=document.getElementById('card-battp');
    cv.className=cp.className='card'+(d.batt_crit?' crit':d.batt_low?' warn':'');

    // Status dot
    const dot=document.getElementById('dot');
    let dotClass='grey',statusText='Sensors powered off';
    if(!sleeping){
      const c=d.led_colour;
      dotClass=c==='GREEN'?'green':c==='YELLOW'?'yellow':c==='RED'?'red':'blue';
      const s2=c==='GREEN'?'All sensors OK':c==='RED'?'Both sensors failed':'One sensor failed';
      statusText=s2+(d.batt_crit?' &mdash; ⚠ BATTERY CRITICAL':d.batt_low?' &mdash; ⚠ Battery low':'');
    }
    dot.className='dot '+dotClass;
    document.getElementById('status-text').innerHTML=statusText;

    document.getElementById('sensor-flags').innerHTML=
      '<span class="flag '+(d.bh1750_found?'ok':'fail')+'">BH1750 '+(d.bh1750_found?'✓':'✗')+'</span>'+
      '<span class="flag '+(d.bmp180_found?'ok':'fail')+'">BMP180 '+(d.bmp180_found?'✓':'✗')+'</span>'+
      '<span class="flag '+(d.batt_ok?'ok':'fail')+'">BATT '+(d.batt_ok?'✓':'✗')+'</span>';

    document.getElementById('state-badge').textContent=s.state;
    const pct=s.phase_duration_ms>0
      ?Math.min(100,Math.round(s.phase_elapsed_ms/s.phase_duration_ms*100)):0;
    document.getElementById('progress-fill').style.width=pct+'%';
    document.getElementById('phase-label').textContent=s.state+' phase';
    document.getElementById('phase-pct').textContent=pct+'%';
    document.getElementById('sleep-notice').style.display=sleeping?'block':'none';

    const ts=new Date().toLocaleTimeString();
    const net=s.ip?'  ·  '+s.ip:''+(s.rssi?'  ·  '+s.rssi+' dBm':'');
    document.getElementById('updated').textContent=ts+net;
    document.getElementById('updated-footer').textContent='Last updated: '+ts+(s.ip?'  ·  IP: '+s.ip:'')+(s.rssi?'  ·  RSSI: '+s.rssi+' dBm':'');
  } catch(e){
    document.getElementById('updated').textContent='Connection error — retrying...';
  }
}
refresh();
setInterval(refresh,3000);
</script>
</body>
</html>
)rawliteral";

// ═══════════════════════════════════════════════
//  JSON BUILDERS
// ═══════════════════════════════════════════════
String buildDataJSON() {
  const char* colour = "OFF";
  if (currentState == STATE_SENSOR_TEST || currentState == STATE_EXTENDED) {
    if      ( luxOk &&  bmpOk) colour = "GREEN";
    else if (!luxOk && !bmpOk) colour = "RED";
    else                        colour = "YELLOW";
  }
  char buf[640];
  snprintf(buf, sizeof(buf),
    "{"
      "\"lux\":%.2f,"
      "\"lux_ok\":%s,"
      "\"temp_c\":%.1f,"
      "\"pressure_station_hpa\":%.2f,"
      "\"pressure_sl_hpa\":%.2f,"
      "\"altitude_m\":%.1f,"
      "\"bmp_ok\":%s,"
      "\"soil_raw\":%d,"
      "\"soil_pct\":%d,"
      "\"soil_ok\":%s,"
      "\"batt_v\":%.3f,"
      "\"batt_pct\":%d,"
      "\"batt_ok\":%s,"
      "\"batt_low\":%s,"
      "\"batt_crit\":%s,"
      "\"bh1750_found\":%s,"
      "\"bmp180_found\":%s,"
      "\"led_colour\":\"%s\","
      "\"sensors_powered\":%s,"
      "\"last_read_ms\":%lu"
    "}",
    lastLux,              luxOk       ? "true" : "false",
    lastTempC,            lastPressStationHPa,
    lastPressSLHPa,       lastAltM,
    bmpOk               ? "true" : "false",
    lastSoilRaw,          lastSoilPct,
    soilOk              ? "true" : "false",
    lastBattV,            lastBattPct,
    battOk              ? "true" : "false",
    battLow             ? "true" : "false",
    battCrit            ? "true" : "false",
    bh1750Found         ? "true" : "false",
    bmp180Found         ? "true" : "false",
    colour,
    (currentState != STATE_SLEEP) ? "true" : "false",
    lastReadMs
  );
  return String(buf);
}

String buildStatusJSON() {
  uint32_t elapsed  = millis() - stateStartMs;
  uint32_t duration = 1;
  switch (currentState) {
    case STATE_SENSOR_TEST: duration = SENSOR_TEST_MS; break;
    case STATE_EXTENDED:    duration = EXTENDED_MS;    break;
    case STATE_SLEEP:       duration = SLEEP_MS;       break;
    default: break;
  }
  char buf[256];
  snprintf(buf, sizeof(buf),
    "{"
      "\"state\":\"%s\","
      "\"uptime_ms\":%lu,"
      "\"phase_elapsed_ms\":%lu,"
      "\"phase_duration_ms\":%lu,"
      "\"ip\":\"%s\","
      "\"rssi\":%d"
    "}",
    stateName(), millis(), elapsed, duration,
    WiFi.localIP().toString().c_str(),
    WiFi.RSSI()
  );
  return String(buf);
}

// ═══════════════════════════════════════════════
//  WEB SERVER — started once, never stopped
// ═══════════════════════════════════════════════
void startWebServer() {
  server.on("/", HTTP_GET, [](AsyncWebServerRequest* req) {
    req->send_P(200, "text/html", HTML_PAGE);
  });
  server.on("/data", HTTP_GET, [](AsyncWebServerRequest* req) {
    req->send(200, "application/json", buildDataJSON());
  });
  server.on("/status", HTTP_GET, [](AsyncWebServerRequest* req) {
    req->send(200, "application/json", buildStatusJSON());
  });
  server.onNotFound([](AsyncWebServerRequest* req) {
    req->send(404, "text/plain", "Not found");
  });
  server.begin();
  Serial.println("[Web] Server started on port 80 — stays up permanently.");
}

// ═══════════════════════════════════════════════
//  RAINBOW  (blocking — short duration)
// ═══════════════════════════════════════════════
void runRainbow() {
  Serial.printf("[Rainbow] %d cycle(s)...\n", RAINBOW_CYCLES);
  for (int c = 0; c < RAINBOW_CYCLES; c++)
    for (int hue = 0; hue < 256; hue++) {
      setPixelHue((uint8_t)hue, 60);
      delay(10);
    }
  Serial.println("[Rainbow] Done.");
}

// ═══════════════════════════════════════════════
//  STATE TRANSITIONS
// ═══════════════════════════════════════════════
void enterSensorTest() {
  Serial.printf("\n== STATE: SENSOR TEST (%d s) ==\n", SENSOR_TEST_MS / 1000);
  // Battery is read BEFORE powerOnSensors() — unloaded reading
  readBattery();
  powerOnSensors();
  currentState = STATE_SENSOR_TEST;
  stateStartMs = millis();
  lastSensorMs = millis() - LOOP_INTERVAL_MS;   // trigger first read immediately
}

void enterExtended() {
  Serial.printf("\n== STATE: EXTENDED (%d s) ==\n", EXTENDED_MS / 1000);
  currentState = STATE_EXTENDED;
  stateStartMs = millis();
}

void enterSleep() {
  Serial.printf("\n== STATE: SLEEP (%d s) ==\n", SLEEP_MS / 1000);
  currentState = STATE_SLEEP;
  stateStartMs = millis();
  powerOffSensors();
}

void enterRainbow() {
  Serial.println("\n== STATE: RAINBOW ==");
  currentState = STATE_RAINBOW;
  runRainbow();
  enterSleep();   // MOSFET off immediately after rainbow
}

// ═══════════════════════════════════════════════
//  SETUP
// ═══════════════════════════════════════════════
void setup() {
  // Disable brownout detector — prevents spurious resets during MOSFET switching
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);

  // ── GPIO init ────────────────────────────────
  digitalWrite(MOSFET_GATE_PIN, LOW);
  pinMode(MOSFET_GATE_PIN, OUTPUT);

  // ── Serial ───────────────────────────────────
  Serial.begin(115200);
  delay(400);
  Serial.println("========================================");
  Serial.printf( "  %s  %s\n", SKETCH_TITLE, SKETCH_VERSION);
  Serial.printf( "  Compiled: %s %s\n", compile_date, compile_time);
  Serial.println("  BH1750FVI + BMP180 + Soil + Battery");
  Serial.println("  MOSFET GPIO4  |  NeoPixel GPIO2");
  Serial.println("  Web server :80  |  WiFi persistent");
  Serial.println("========================================\n");

  // ── WiFi + web server start once ─────────────
  connectWiFi();
  startWebServer();

  // ── First sensor cycle ────────────────────────
  // enterSensorTest() calls readBattery() before MOSFET on
  enterSensorTest();
}

// ═══════════════════════════════════════════════
//  LOOP
// ═══════════════════════════════════════════════
void loop() {
  uint32_t now = millis();

  switch (currentState) {

    case STATE_SENSOR_TEST:
      if (now - lastSensorMs >= LOOP_INTERVAL_MS) {
        lastSensorMs = now;
        readSensors();
      }
      if (now - stateStartMs >= SENSOR_TEST_MS) enterExtended();
      break;

    case STATE_EXTENDED:
      if (now - lastSensorMs >= LOOP_INTERVAL_MS) {
        lastSensorMs = now;
        readSensors();
      }
      if (now - stateStartMs >= EXTENDED_MS) enterRainbow();
      break;

    case STATE_SLEEP:
      if (now - stateStartMs >= SLEEP_MS) {
        Serial.println("\n== Restarting cycle ==");
        enterSensorTest();
      }
      break;

    case STATE_RAINBOW:   // blocking — handled inside enterRainbow()
    default:
      break;
  }
}
